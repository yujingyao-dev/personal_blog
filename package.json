{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "check:env": "node scripts/check-env.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:artifacts": "node scripts/verify-build-artifacts.mjs",
    "check:routes": "node scripts/route-contract-smoke.mjs",
    "check:runtime": "node scripts/runtime-independence-smoke.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings scripts/unit-image-hosts.mjs",
    "build": "node scripts/check-env.mjs --strict && tinacms build && node scripts/verify-build-artifacts.mjs --strict && node scripts/validate-content.mjs --strict && next build && node scripts/runtime-independence-smoke.mjs && node scripts/route-contract-smoke.mjs",
    "build:local": "node scripts/build-local.mjs",
    "check:local-api": "node scripts/check-local-api.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke:admin": "node scripts/admin-smoke.mjs",
    "smoke:visual": "node scripts/visual-edit-smoke.mjs",
    "smoke:interaction": "node scripts/interaction-smoke.mjs",
    "smoke:draft": "node scripts/content-guards-smoke.mjs",
    "smoke:save": "node scripts/save-smoke.mjs",
    "smoke:http": "node scripts/http-status-smoke.mjs",
    "smoke:prod": "node scripts/verify-prod.mjs",
    "smoke": "npm run smoke:http && npm run smoke:admin && npm run smoke:visual && npm run smoke:interaction && npm run smoke:save"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tinacms": "3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tinacms/cli": "2.7.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
